---
import Layout from "../layouts/Layout.astro";
import Badge from "../components/Badge.astro";
import Linkedin from "../icons/Social/Linkedin.astro";
import Github from "../icons/Social/Github.astro";
import Social_icons from "../components/Social_icons.astro";
import Gmail from "../icons/Social/Gmail.astro";
import Section from "../components/Section.astro";
import Section_tecno from "../components/Section_tecno.astro";
import Tecnologias from "../components/Tecnologias.astro";
import Code from "../icons/Titulos/Code.astro";
import Proyectos from "../components/Proyectos.astro";
import Certificados from "../components/Certificados.astro";
import Sobre_mi from "../components/Sobre_mi.astro";
import Cert_icon from "../icons/Titulos/Cert_icon.astro";
import Me_icons from "../icons/Titulos/Me_icon.astro";
import Section_sobremi from "../components/Section_sobremi.astro";
import Footer from "../components/Footer.astro";
import Discord from "../icons/Social/Discord.astro";
import Section_certificados from "../components/Section_certificados.astro";
---

<Layout title="Alejo Rodríguez | Programador Full-Stack" description="Portafolio de Alejo Rodríguez, programador Full-Stack de Tucumán, Argentina. Proyectos web, automatización, IA y sistemas de gestión.">
	<a class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-white focus:px-4 focus:py-2 focus:text-black" href="#contenido">Saltar al contenido</a>
	<main id="top" class="px-4">
		<Section>
			<div id="contenido">
				<img class="mb-4 size-20 rounded-full" src="/alejo-avatar.gif" alt="Avatar animado de Alejo Rodríguez" width="80" height="80" />
				<div class="flex flex-wrap items-center gap-x-5 gap-y-2 pb-6 lg:pb-10">
					<h1 class="text-3xl font-bold text-white md:text-4xl lg:text-5xl">Hola, soy Alejo</h1>
					<a class="focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-300" href="https://www.linkedin.com/in/alejo-rodriguez-43b561387" target="_blank" rel="noopener noreferrer" aria-label="Ver perfil de LinkedIn de Alejo Rodríguez"><Badge>Open To Work</Badge></a>
				</div>
				<h2 class="max-w-[700px] text-xl opacity-80 text-pretty lg:text-2xl"><span class="text-blue-300">Programador Full-Stack.</span><br />Tengo 25 años, soy de Tucumán, Argentina 🧉. Me especializo en tecnología y desarrollo de software, siempre buscando aprender y mejorar. Mi objetivo es participar en proyectos innovadores que amplíen mis conocimientos y permitan aportar soluciones creativas y efectivas.</h2>
				<nav class="mt-6 flex flex-wrap gap-3 md:gap-5" aria-label="Perfiles y contacto">
					<Social_icons href="https://www.linkedin.com/in/alejo-rodriguez-43b561387"><Linkedin class="size-4 md:size-6" />LinkedIn</Social_icons>
					<Social_icons href="https://github.com/Alejor-Dev"><Github class="size-4 md:size-6" />GitHub</Social_icons>
					<Social_icons href="mailto:rodaleagu@gmail.com"><Gmail class="size-4 md:size-6" />rodaleagu@gmail.com</Social_icons>
					<Social_icons href="https://discord.com/users/222491467275436033"><Discord class="size-4 md:size-6" />x_alejo_x</Social_icons>
				</nav>
				<div class="mt-6 flex flex-wrap gap-3"><a class="rounded-full bg-blue-400 px-4 py-2 text-sm font-semibold text-slate-950 transition hover:bg-blue-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white" href="mailto:rodaleagu@gmail.com">Contactarme</a><a class="rounded-full border border-white/20 px-4 py-2 text-sm font-semibold transition hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-300" href="#proyectos">Ver proyectos</a></div>
			</div>
			<Section_tecno id="tecnologias"><Tecnologias /></Section_tecno>
			<Section id="proyectos"><div class="flex justify-center"><h2 class="mb-4 flex items-center gap-x-3 pb-10 text-center text-4xl font-semibold"><Code class="size-8" />Proyectos</h2></div><Proyectos /></Section>
			<Section_certificados id="certificados"><div class="flex justify-center"><h2 class="mb-4 flex items-center gap-x-3 pb-10 text-center text-4xl font-semibold"><Cert_icon class="size-8" />Certificados</h2></div><Certificados /></Section_certificados>
			<Section_sobremi id="sobre_mi"><div class="flex justify-center"><h2 class="mb-4 flex items-center gap-x-3 pb-10 text-center text-4xl font-semibold"><Me_icons class="size-8" />Sobre mí</h2></div><Sobre_mi /></Section_sobremi>
			<Footer />
		</Section>
	</main>
</Layout>
